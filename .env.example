# Firebase web app config — from your Firebase console: Project settings > General > Your apps.
REACT_APP_FIREBASE_KEY=your-firebase-api-key
REACT_APP_FIREBASE_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
REACT_APP_FIREBASE_SENDER_ID=your-messaging-sender-id
REACT_APP_MESSAGING_APP_ID=your-firebase-app-id
# Note: variable name misspelling ("MEASSUREMENT") matches what src/firebase.js actually reads.
REACT_APP_MEASSUREMENT_ID=your-firebase-analytics-measurement-id
